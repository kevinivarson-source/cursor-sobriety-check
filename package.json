{
  "name": "cursor-sobriety-check",
  "version": "1.0.1",
  "private": false,
  "description": "A free, one-click add-on for Cursor. Reminds the agent of your rules, warns you when chat memory is compressed, and keeps a private local report.",
  "type": "module",
  "bin": {
    "cursor-sobriety-check": "./bin/cursor-sobriety-check"
  },
  "scripts": {
    "cursor-sobriety-check:install": "node cli.mjs install",
    "cursor-sobriety-check:uninstall": "node cli.mjs uninstall",
    "cursor-sobriety-check:status": "node cli.mjs status",
    "cursor-sobriety-check:report": "node cli.mjs report --open"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "author": "Durellem Ltd",
  "homepage": "https://github.com/kevinivarson-source/cursor-sobriety-check",
  "bugs": {
    "url": "https://github.com/kevinivarson-source/cursor-sobriety-check/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kevinivarson-source/cursor-sobriety-check.git"
  },
  "keywords": [
    "cursor-sobriety-check",
    "cursor",
    "cursor-ide",
    "hooks",
    "ai",
    "observability",
    "durellem"
  ]
}
